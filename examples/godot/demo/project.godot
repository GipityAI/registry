; Gip Racer: a tiny top-down lap racer that exercises the Gipity addon end to end.
config_version=5

[application]

config/name="Gip Racer"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Gipity="*res://addons/gipity/gipity.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gipity/plugin.cfg")

[gipity]

app_guid="p_knhy4q6n"
api_base="https://a.gipity.ai"

[rendering]

renderer/rendering_method="gl_compatibility"
