{
  "name": "@gipity/records",
  "version": "1.2.1",
  "type": "module",
  "main": "api.js",
  "description": "Registry-driven generic data plane: objects/fields declared as data, generic CRUD functions with validation + full-text search, soft delete, ACTOR provenance, and a transactional audit event spine.",
  "gipity": {
    "kit": true,
    "install": {
      "importMap": {
        "@gipity/records": "./packages/records/api.js",
        "@gipity/records/": "./packages/records/"
      },
      "functions": true,
      "migrations": true,
      "deployPhase": {
        "name": "functions",
        "type": "functions",
        "source": "functions",
        "function_definitions": [
          {
            "name": "record-read",
            "auth": "public",
            "tables": ["kit_objects", "kit_fields", "kit_events"]
          },
          {
            "name": "record-write",
            "auth": "user",
            "tables": ["kit_objects", "kit_fields", "kit_members", "kit_events"]
          }
        ]
      }
    }
  }
}
