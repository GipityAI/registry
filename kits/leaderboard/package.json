{
  "name": "@gipity/leaderboard",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "description": "Leaderboards for any game: high scores or best times, ranked all-time, daily, weekly, monthly or by named season, with an optional tiebreak score, server-side plausibility checks (score bounds, official rulesets, checkpoint splits, rate limits), around-me and friends views, attached replays, and owner moderation. Works from a web game (Gipity.fn) or any native client over HTTPS.",
  "gipity": {
    "kit": true,
    "engineAgnostic": true,
    "install": {
      "importMap": {
        "@gipity/leaderboard": "./packages/leaderboard/index.js",
        "@gipity/leaderboard/": "./packages/leaderboard/"
      },
      "functions": true,
      "migrations": true,
      "deployPhase": {
        "name": "functions",
        "type": "functions",
        "source": "functions",
        "function_definitions": [
          {
            "name": "leaderboard-submit",
            "auth": "user",
            "tables": ["lb_boards", "lb_entries", "lb_ghosts", "lb_bans", "lb_submissions", "lb_seasons"]
          },
          {
            "name": "leaderboard-read",
            "auth": "public",
            "tables": ["lb_boards", "lb_entries", "lb_ghosts", "lb_bans", "lb_seasons"]
          },
          {
            "name": "leaderboard-admin",
            "auth": "member",
            "tables": ["lb_boards", "lb_entries", "lb_ghosts", "lb_bans", "lb_submissions", "lb_seasons"]
          }
        ]
      }
    }
  }
}
