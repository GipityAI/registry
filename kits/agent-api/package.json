{
  "name": "@gipity/agent-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Named API keys for agent/script writes through the records kit's single write path - machine writes carry AGENT/API actor attribution on the same audit spine as human edits.",
  "gipity": {
    "kit": true,
    "install": {
      "functions": true,
      "migrations": true,
      "requires": ["records"],
      "deployPhase": {
        "name": "functions",
        "type": "functions",
        "source": "functions",
        "function_definitions": [
          {
            "name": "agent-write",
            "auth": "public",
            "tables": ["kit_objects", "kit_fields", "kit_api_keys", "kit_events"]
          }
        ]
      }
    }
  }
}
